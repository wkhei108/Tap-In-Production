# ---------------------------------------------------------------------------
# TAP IN. — environment variables
#
# Copy to `.env.local` for development, and set the same values in your
# hosting provider for production. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, hreflang,
# sitemap.xml, robots.txt, Open Graph URLs and JSON-LD.
# Replace with the real domain once TAP IN. confirms it.
NEXT_PUBLIC_SITE_URL=https://tapin.hk

# ---------------------------------------------------------------------------
# Contact form delivery
# ---------------------------------------------------------------------------

# Where enquiries are sent. Defaults to the address in src/content/site.ts.
CONTACT_TO_EMAIL=tap.in.enquiry@gmail.com

# Resend API key (https://resend.com). Server-side only — never prefixed with
# NEXT_PUBLIC_, so it is never exposed to the browser.
#
# Leave this unset in development: the form validates and posts normally, the
# payload is logged to the server console, and the visitor is told plainly
# that the enquiry was not delivered. The form never fakes a success.
RESEND_API_KEY=

# Verified sender for Resend. Must be on a domain verified in your Resend
# account. `onboarding@resend.dev` works for testing to your own address only.
CONTACT_FROM_EMAIL=TAP IN. Website <enquiries@tapin.hk>

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Plausible site domain (cookieless analytics). Leave blank and NO analytics
# script is loaded at all — which is why the site currently needs no cookie
# banner. If you switch to a provider that sets non-essential cookies, add a
# consent banner before launch.
NEXT_PUBLIC_ANALYTICS_ID=

# WhatsApp number in international format, e.g. +852 1234 5678. Leave blank
# and the WhatsApp row is omitted from the contact page rather than rendering
# a dead link.
NEXT_PUBLIC_WHATSAPP_NUMBER=
